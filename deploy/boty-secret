#!/usr/bin/env bash
# boty-secret — set a bot-y credential without it touching shell history,
# the terminal scrollback, or a chat transcript.
#
#   boty-secret telegram   # prompts for the BotFather token, sends a test message
#   boty-secret bestbuy    # prompts for the Best Buy API key, verifies it
#
# Reads with `read -s` (no echo) and writes to a mode-600 file the service
# loads via EnvironmentFile. Nothing is passed as an argument, so nothing
# lands in `ps` output or ~/.bash_history either.
set -euo pipefail

ENV_FILE="${BOTY_ENV_FILE:-$HOME/.config/boty/env}"
CHAT_ID="${BOTY_CHAT_ID:-8119711705}"

usage() { echo "usage: boty-secret {telegram|bestbuy}" >&2; exit 2; }
[ $# -eq 1 ] || usage

mkdir -p "$(dirname "$ENV_FILE")"
touch "$ENV_FILE"; chmod 600 "$ENV_FILE"

# Replace KEY=... in place, or append if absent. Written via a temp file so a
# failure mid-write cannot leave a half-populated secrets file.
put() {
  local key="$1" val="$2" tmp
  tmp="$(mktemp)"; chmod 600 "$tmp"
  grep -v "^${key}=" "$ENV_FILE" > "$tmp" 2>/dev/null || true
  printf '%s=%s\n' "$key" "$val" >> "$tmp"
  mv "$tmp" "$ENV_FILE"; chmod 600 "$ENV_FILE"
}

case "$1" in
  telegram)
    read -rsp 'BotFather token (input hidden): ' TOKEN; echo
    [ -n "$TOKEN" ] || { echo "empty token, nothing written" >&2; exit 1; }
    if ! printf '%s' "$TOKEN" | grep -qE '^[0-9]{6,}:[A-Za-z0-9_-]{30,}$'; then
      echo "that does not look like a BotFather token (expected 123456:AA...)" >&2
      exit 1
    fi

    # Verify BEFORE writing — a token that does not work is worse than none,
    # because the monitor would look configured and stay silent.
    echo -n "checking token with Telegram... "
    if ! resp=$(curl -fsS --max-time 15 "https://api.telegram.org/bot${TOKEN}/getMe"); then
      echo "FAILED (Telegram rejected it). Nothing written."; exit 1
    fi
    echo "ok — $(printf '%s' "$resp" | grep -oE '"username":"[^"]+"' | cut -d'"' -f4)"

    BOT_NAME="$(printf '%s' "$resp" | grep -oE '"username":"[^"]+"' | cut -d'"' -f4)"
    TEST_TEXT="bot-y is wired up. You will get a message here when the GO Plus + is buyable."

    send_test() {  # $1 = chat id
      curl -fsS --max-time 15 -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
        -d "chat_id=$1" --data-urlencode "text=${TEST_TEXT}" >/dev/null 2>&1
    }

    echo -n "sending a test message to chat ${CHAT_ID}... "
    if send_test "$CHAT_ID"; then
      echo "sent — check your phone."
    else
      # Telegram bots cannot open a conversation; the user must speak first.
      # A brand-new bot therefore has no chat, and a stale id is indistinguishable
      # from that. Rather than guess, wait for a real message and read the id
      # straight off it.
      echo "no chat yet."
      echo
      echo "  Open Telegram, find @${BOT_NAME}, and send it any message (tap Start)."
      echo "  Waiting up to 3 minutes..."
      CHAT_ID=""
      for _ in $(seq 1 36); do
        sleep 5
        upd="$(curl -fsS --max-time 10 "https://api.telegram.org/bot${TOKEN}/getUpdates" 2>/dev/null || true)"
        found="$(printf '%s' "$upd" | grep -oE '"chat":\{"id":-?[0-9]+' | head -1 | grep -oE '\-?[0-9]+$' || true)"
        if [ -n "$found" ]; then CHAT_ID="$found"; break; fi
        printf '.'
      done
      echo
      [ -n "$CHAT_ID" ] || { echo "no message received — nothing written." >&2; exit 1; }
      echo "found chat id ${CHAT_ID}"
      echo -n "sending a test message... "
      send_test "$CHAT_ID" || { echo "FAILED. Nothing written." >&2; exit 1; }
      echo "sent — check your phone."
    fi

    put BOTY_NOTIFY_URL "tgram://${TOKEN}/${CHAT_ID}"
    unset TOKEN
    echo "written to $ENV_FILE"
    ;;

  bestbuy)
    read -rsp 'Best Buy API key (input hidden): ' KEY; echo
    [ -n "$KEY" ] || { echo "empty key, nothing written" >&2; exit 1; }
    echo -n "checking key with Best Buy... "
    if curl -fsS --max-time 20 \
        "https://api.bestbuy.com/v1/products(sku=6537176)?apiKey=${KEY}&format=json&show=sku,name" \
        >/dev/null 2>&1; then
      echo "ok"
    else
      echo "FAILED (Best Buy rejected it). Nothing written." >&2; exit 1
    fi
    put BESTBUY_API_KEY "$KEY"
    unset KEY
    echo "written to $ENV_FILE"
    ;;

  *) usage ;;
esac

echo
echo "restart the monitor to pick it up:  sudo systemctl restart boty"
