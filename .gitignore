# changedetection.io datastore — holds its API key and notification URLs
datastore/

.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Belt-and-braces. Ruff writes .ruff_cache/.gitignore containing `*`, so the
# cache already self-ignores — but that is ruff's implementation detail rather
# than a contract, and this repo's gates enumerate files THROUGH git
# (identity_check.py --all, and the packaging test's tracked-top-level-dirs
# rule). A change upstream would surface as a confusing red packaging test
# rather than as an obvious cache directory.
.ruff_cache/

.env
*.log
state.json
# The pacer's runtime memory: how many times each retailer has refused in a row
# and which ones have already been paged about it. It needs its own line — the
# entry above is a literal basename and does not match this one — so without it
# the first `boty watch` in a checkout offers the file for commit.
pacer-state.json

# changedetection.io stack — separate tool, kept on disk for the dashboard
# of unguarded sites, but not part of bot-y
docker-compose.yml
served/boty/status.json
